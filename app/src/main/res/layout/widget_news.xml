<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <RelativeLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:letterSpacing="0.12"
            android:text="今日公告"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:text="↻"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/w_title"
            android:layout_alignParentStart="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:text="尚未更新"
            android:textColor="#8CFFFFFF"
            android:textSize="10sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#24FFFFFF" />

    <TextView
        android:id="@+id/w_l1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="今天暫無公告"
        android:textColor="#E8FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_s1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:textColor="#73FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_l2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E8FFFFFF"
        android:textSize="13sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/w_s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:textColor="#73FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_l3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E8FFFFFF"
        android:textSize="13sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/w_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:textColor="#73FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
